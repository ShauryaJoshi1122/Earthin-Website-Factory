# ==========================================
# EARTHIN WEBSITE FACTORY — ENVIRONMENT CONFIG
# ==========================================

# Application URL & Environment
APP_URL=https://factory.earthin.online
APP_ENV=development
PORT=3000

# Database — Neon PostgreSQL (via Vercel Marketplace)
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Authentication Secrets (Session tokens & cookie encryption)
# Generate via: openssl rand -base64 32
AUTH_SECRET=earthin_factory_dev_secret_replace_in_production_32chars!

# Hosting & Deployment Security
# ENCRYPTION_KEY: 32-byte hex string (64 characters) for AES-256-GCM encryption of hosting API tokens & DB credentials
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# DEPLOYMENT_SIGNING_KEY: Secret key for HMAC-SHA256 signature on automated CMS installation manifests
# Generate via: openssl rand -hex 32
DEPLOYMENT_SIGNING_KEY=earthin_manifest_signing_key_secret_2026

# Storage — Vercel Blob (Private store for CMS packages, backups, branding)
# Provided automatically when Vercel Blob is connected in Vercel Dashboard
BLOB_READ_WRITE_TOKEN=

# Existing CMS Source of Truth
CMS_REPOSITORY_URL=https://github.com/ShauryaJoshi1122/News-Crms
